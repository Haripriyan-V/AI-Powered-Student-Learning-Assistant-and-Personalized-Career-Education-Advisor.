# ==============================================================================
# DishaAI Backend Production & Development Environment Configuration
# Copy this file to .env and configure values for your environment.
# NEVER commit the real .env file containing secrets into source control.
# ==============================================================================

# Core Django Security
# Generate a secure 50+ character random key for production
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DEBUG=False
# Comma-separated list of allowed hostnames (e.g., your-backend.onrender.com,api.yourdomain.com)
ALLOWED_HOSTS=127.0.0.1,localhost,your-backend-domain.com

# Database Configuration
# In production (PostgreSQL / Managed Cloud Database):
# DATABASE_URL=postgresql://dbuser:dbpassword@dbhost:5432/dbname
DATABASE_URL=
# Fallback local configuration: 'sqlite' or 'mysql'
DB_ENGINE=sqlite
DB_NAME=sih25094_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# SimpleJWT Token Lifetimes
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS & CSRF Security (Phase 11 & Phase 12)
# Comma-separated origins of your deployed frontend(s)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-backend-domain.com,https://your-frontend-domain.com

# AI / LLM Configuration (DishaAI Assistant)
# Supported AI_PROVIDER values: gemini, groq, openai
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_groq_or_openai_api_key_here
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT=30
